VITE_FIREBASE_AUTH_DOMAIN="socializaciones-meraki.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="socializaciones-meraki"
VITE_FIREBASE_STORAGE_BUCKET="socializaciones-meraki.firebasestorage.app"
